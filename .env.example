# Every variable the services read, with its default and what a change needs:
# docs/configuration.md

# ── Required ────────────────────────────────────────────────────────────────
# Stack will refuse to start (clear error) if these are missing.

ELEFANT_SESSION_SECRET=             # openssl rand -hex 32
ELEFANT_PUBLIC_DOMAIN=wiki.example.com
ELEFANT_INTERNAL_SERVICE_TOKEN=     # openssl rand -hex 32
                                    # Shared secret used between Elefant
                                    # containers (editor ↔ embedder ↔
                                    # memory-api ↔ mcp). Without it,
                                    # cross-service writes — compactor
                                    # promotions, org backup/restore,
                                    # hard-purge — fail closed.

POSTGRES_PASSWORD=                  # high-entropy string; the bundled
                                    # Postgres holds every tenant's hot-
                                    # tier captures, events, and audit
                                    # revisions.

# ── Optional (have working defaults) ────────────────────────────────────────

# ELEFANT_APP_NAME=Elefant                            # display name shown in the UI
# PORT=8321                                           # host port for nginx (default 8321)
# MCP_PORT=8322                                       # host port for mcp direct access (default 8322)
# EMBEDDING_MODEL=multi-qa-distilbert-cos-v1        # local sentence-transformers model (the stack default)

# ── Diagrams ─────────────────────────────────────────────────────────────────
# The diagram-validator service checks every diagram an agent writes, and the
# MCP tools refuse to save one when no validator answers. Set this to true to
# save unchecked diagrams instead (they are marked validated: false).
# COMPOSE_PROFILES=diagrams adds the optional image renderer (headless Chromium).
# DIAGRAM_ALLOW_UNVALIDATED=false
# COMPOSE_PROFILES=diagrams

# ── Board evaluation lock ────────────────────────────────────────────────────
# An automated reviewer takes a lock on a card while it evaluates it, and the
# board shows the card as under evaluation until it releases. A run that dies
# mid-evaluation never releases, so a lock this old is treated as stale and the
# next acquire breaks it (recording that it did). Raise it if your reviewer runs
# checks slower than this; it has to exceed a WHOLE evaluation, not one step of
# one, because re-acquiring a lock deliberately does not refresh its clock.
# ELEFANT_CARD_EVAL_LOCK_STALE_SECONDS=1800           # 30 minutes (the default)

# ── External embeddings (OpenAI or a custom endpoint) ───────────────────────
# Choose the embedding provider, model and API key in the admin settings. The
# embedder's EMBEDDING_PROVIDER / OPENAI_API_KEY variables are only a fallback
# for when the editor cannot be reached, and docker-compose.yml does not pass
# them from this file. See docs/configuration.md.

# ── Slim embedder image (external/custom embedding backend) ──────────────────
# When embeddings run OFF-box (EMBEDDING_PROVIDER=openai|custom), the embedder
# container never loads sentence-transformers/torch — so you can pull the
# torch-free "slim" image instead of the default full one. It's ~2GB smaller,
# so layer updates are quick. Only switch this on together with an external
# provider above; a slim image asked to run EMBEDDING_PROVIDER=local fails fast
# with a clear error. (Local `docker compose build` of slim: EMBEDDER_INCLUDE_LOCAL=false)
# EMBEDDER_IMAGE=ghcr.io/zennthic/elefant/embedder:slim

# Which build of Elefant's own six images to run. Unset means `latest`, which
# is the most recent build of main — that is what a manual `docker compose up`
# has always given you, and it stays the default.
#
# Set it to run one exact release. CI sets ELEFANT_TAG=main-<sha7> for every
# Stage deploy, so the deployed build is recorded rather than guessed, and two
# Stages asked for the same tag run byte-identical images. A self-hoster pins a
# version the same way: ELEFANT_TAG=v1.2.3.
#
# It applies to the default embedder image too, so EMBEDDER_IMAGE (above) still
# wins outright when you set it — pin the tag in that value if you want both.
# ELEFANT_TAG=main-a1b2c3d

# ── Deployment mode ───────────────────────────────────────────────────────────
# Every feature is on in every install: unlimited users, MCP OAuth, OIDC and
# SAML sign-in, git sources, groups and teams. ELEFANT_MODE only picks the
# deployment's shape.
#
# One organisation (default). The first account is its org admin:
# ELEFANT_MODE=single-org
#
# Host many organisations, each its own tenant with its own domains, run by a
# platform admin (set PLATFORM_ADMIN_USERNAME / _PASSWORD below):
# ELEFANT_MODE=multi-org
#
# Older .env files set ELEFANT_TIER instead. ELEFANT_TIER=saas still means
# multi-org (with a deprecation warning in the log); other values are ignored.

# ── Multi-tenant docs (advanced — leave unset for single-tenant installs) ─────
# MULTI_TENANT_DOCS=true    # enables path-based tenant derivation in embedder

# ── Object storage for wiki content ────────────────────────────────────────
# S3 is the only supported backend for wiki content. Elefant ships with a
# bundled MinIO service (the "local" option for self-hosted deployments) so
# the defaults below work out of the box. CHANGE the access/secret keys
# before any deployment that's reachable beyond localhost — they double as
# the MinIO root credentials.
#
# To use managed S3 / R2 / B2 / Wasabi instead of the bundled MinIO, set
# ELEFANT_S3_ENDPOINT_URL to your provider's endpoint (or leave empty for
# AWS S3 over the public endpoints) and supply the matching credentials.
#
# Each org gets its own bucket named "<org_slug>--default" at creation time
# (seeded with a welcome page). Additional wikis live in their own buckets
# following the pattern "<org_slug>--<wiki_name>". For AWS S3 deployments
# set ELEFANT_S3_BUCKET_PREFIX to a deployment-scoped value (e.g. your
# company name) since S3 bucket names are globally unique; for MinIO the
# prefix can be left empty.
#
# ELEFANT_S3_ENDPOINT_URL=http://minio:9000      # bundled MinIO; empty = AWS S3 default
# ELEFANT_S3_REGION=us-east-1
ELEFANT_S3_ACCESS_KEY=               # required; doubles as MinIO root user
ELEFANT_S3_SECRET_KEY=               # required (>=8 chars); doubles as MinIO root password
# ELEFANT_S3_BUCKET_PREFIX=                      # empty for MinIO; e.g. "zennthic-" for AWS
