#!/usr/bin/env python3
"""reset-password — break-glass password reset for local Elefant accounts.

Usage: reset-password [--list | <login> [<password>]]
Run `reset-password --help` for details. The logic lives in reset_password.py,
next to the editor's main.py (/app in the image).
"""
import os
import sys

for _dir in (os.environ.get("ELEFANT_APP_DIR", "/app"),
             os.path.dirname(os.path.realpath(__file__))):
    if _dir not in sys.path:
        sys.path.insert(0, _dir)

from reset_password import main  # noqa: E402

sys.exit(main())
